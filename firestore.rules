rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehDono(userId) {
      return estaLogado() && request.auth.uid == userId;
    }

    function cargoDoUsuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cargo;
    }

    function ehAdmin() {
      return estaLogado() && cargoDoUsuario() == 'admin';
    }

    // Estado de moderacao de quem esta fazendo a chamada, pra barrar posts e
    // votos de conta banida/suspensa mesmo que a pessoa contorne o app e
    // escreva direto no Firestore (o app so esconde a UI — quem impede de
    // verdade e a regra). .get(campo, padrao) evita erro em conta que nunca
    // foi moderada, que nao tem esses campos gravados (ver
    // UserModel.toFirestore: eles so existem depois da primeira acao do
    // Painel ADM).
    function dadosDoUsuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function contaBloqueada() {
      let estado = dadosDoUsuario().get('estadoModeracao', 'ativo');
      let suspensoAte = dadosDoUsuario().get('suspensoAte', null);
      return estado == 'banido' || (estado == 'suspenso' && suspensoAte != null && suspensoAte > request.time);
    }

    // Peso do post na ordenacao do feed. Os mesmos numeros estao em
    // PostModel.prioridadeDoCargo — la e so leitura; e AQUI que um inscrito
    // fica impedido de publicar com prioridade de admin.
    function prioridadeDoCargo(cargo) {
      return cargo == 'admin' ? 100 : 0;
    }

    function tipoDePostagemValido(tipo) {
      return tipo in ['avisoTexto', 'aoVivo', 'avisoFoto', 'avisoMidia', 'enquete'];
    }

    // Vota numa enquete: qualquer usuario logado pode, uma unica vez por post,
    // e a escrita so pode alterar 'opcoes', 'votantes' e 'votosPorUsuario'
    // (nada mais do post). votosPorUsuario guarda qual opcao cada uid
    // escolheu, pra UI poder destacar o botao que o usuario apertou.
    function podeVotar() {
      return estaLogado()
        && !contaBloqueada()
        && resource.data.tipo == 'enquete'
        && !(request.auth.uid in resource.data.get('votantes', []))
        && request.resource.data.votantes == resource.data.get('votantes', []).concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opcoes', 'votantes', 'votosPorUsuario']);
    }

    // Quem apaga a propria conta tira o proprio uid das enquetes em que
    // votou — inclusive das dos outros, que ele nao pode apagar. E o unico
    // jeito de o rastro dele sumir sem o Admin SDK.
    //
    // **A contagem em 'opcoes' fica travada de proposito.** O que
    // identifica a pessoa e o uid; o total de votos e numero agregado, que
    // nao aponta pra ninguem. Tirar o nome e deixar o numero e o que
    // anonimizar significa — e liberar 'opcoes' nesta regra daria ao
    // cliente uma porta pra reescrever placar de enquete alheia, que e
    // justamente o que 'podeVotar' passa o tempo todo impedindo.
    //
    // As tres condicoes sobre 'votantes' juntas dizem "saiu exatamente um,
    // e fui eu": o meu uid nao esta mais la, nada novo entrou, e a lista
    // encolheu em um. Rules nao tem subtracao de lista; e assim que se
    // descreve a remocao de um item so.
    function podeTirarOProprioVoto() {
      return estaLogado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votantes', 'votosPorUsuario'])
        && !(request.auth.uid in request.resource.data.get('votantes', []))
        && resource.data.get('votantes', []).hasAll(request.resource.data.get('votantes', []))
        && request.resource.data.get('votantes', []).size() == resource.data.get('votantes', []).size() - 1
        && !(request.auth.uid in request.resource.data.get('votosPorUsuario', {}));
    }

    // Curtir e descurtir o proprio "gostei", e nada alem disso.
    //
    // A regra e escrita nos dois sentidos porque rules nao tem subtracao de
    // lista: **entrar** e a lista virar exatamente a antiga mais o meu uid;
    // **sair** e o meu uid nao estar mais la, nada novo ter entrado, e a
    // lista ter encolhido em exatamente um.
    //
    // `hasOnly(['curtidoPor'])` e o que impede a curtida de virar carona
    // pra outra coisa: ninguem edita o texto do post, troca o autor nem
    // mexe em enquete por esta porta.
    //
    // **Nao existe contador `curtidas` separado**, de proposito: a contagem
    // e o tamanho desta lista. Um numero guardado ao lado seria uma segunda
    // fonte de verdade pro mesmo fato, e nenhuma regra conseguiria garantir
    // que os dois nao divergissem.
    function podeCurtir() {
      return estaLogado()
        && !contaBloqueada()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curtidoPor'])
        && (
          // curtindo
          (!(request.auth.uid in resource.data.get('curtidoPor', []))
            && request.resource.data.curtidoPor == resource.data.get('curtidoPor', []).concat([request.auth.uid]))
          ||
          // descurtindo
          (!(request.auth.uid in request.resource.data.get('curtidoPor', []))
            && resource.data.get('curtidoPor', []).hasAll(request.resource.data.get('curtidoPor', []))
            && request.resource.data.get('curtidoPor', []).size() == resource.data.get('curtidoPor', []).size() - 1)
        );
    }

    function categoriasValidas(categorias) {
      return categorias is list &&
        categorias.hasOnly(['otaku', 'gamer', 'streamer', 'geek', 'outro']);
    }

    function statusValido(status) {
      return status in ['online', 'invisivel', 'naoPerturbe', 'offline'];
    }

    match /users/{userId} {
      allow read: if estaLogado();

      // cargo pode ser 'inscrito', 'vip' ou 'admin'. 'vip' e 'admin' sao
      // atribuidos manualmente (nunca no cadastro), por isso o create abaixo
      // so aceita 'inscrito', e o update trava o cargo contra mudanca pelo cliente.
      allow create: if ehDono(userId)
        && request.resource.data.cargo == 'inscrito'
        // 'novato' e concedida automaticamente no cadastro (ver
        // UserModel.novoInscrito); qualquer outra badge so pode ser
        // concedida por um backend de confianca (fora do alcance do
        // cliente), por isso o update abaixo trava 'badges' contra mudanca.
        && (request.resource.data.badges == [] || request.resource.data.badges == ['novato'])
        && request.resource.data.contadores.comentarios == 0
        && request.resource.data.contadores.curtidas == 0
        && request.resource.data.contadores.cliquesLive == 0
        && categoriasValidas(request.resource.data.categorias)
        && statusValido(request.resource.data.status)
        && request.resource.data.ultimoAcesso == request.time;

      allow update: if ehDono(userId)
        && request.resource.data.cargo == resource.data.cargo
        && request.resource.data.badges == resource.data.badges
        && request.resource.data.contadores == resource.data.contadores
        // O dono NAO pode mudar o proprio estado de moderacao — sem isso,
        // uma conta banida conseguiria se desbanir sozinha numa escrita
        // comum de perfil (nada aqui barrava esses 3 campos antes). Quem
        // muda e so o admin, pela regra de baixo.
        && request.resource.data.get('estadoModeracao', 'ativo') == resource.data.get('estadoModeracao', 'ativo')
        && request.resource.data.get('suspensoAte', null) == resource.data.get('suspensoAte', null)
        && request.resource.data.get('motivoModeracao', null) == resource.data.get('motivoModeracao', null)
        && categoriasValidas(request.resource.data.categorias)
        && statusValido(request.resource.data.status)
        && request.resource.data.ultimoAcesso == request.time;

      // O Painel ADM (lib/view/PainelAdmin.dart) precisa banir/suspender
      // outras contas. Isso e uma escrita num documento que NAO e do
      // proprio usuario, entao precisa de uma regra separada da de cima —
      // e restrita: o admin so mexe nos campos de moderacao, nunca em
      // badges/contadores/cargo por essa via.
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estadoModeracao', 'suspensoAte', 'motivoModeracao'])
        && request.resource.data.estadoModeracao in ['ativo', 'suspenso', 'banido'];

      // O dono apaga a propria conta (Configuracoes > excluir conta); o
      // admin apaga a de qualquer um pelo Painel ADM, junto com os posts
      // dela (ver AdminRepository.removerUsuario).
      allow delete: if ehDono(userId) || ehAdmin();
    }

    // Mapeia nickname (em minusculo) -> email/uid, pra permitir login com
    // nickname sem precisar de leitura autenticada na colecao users (o
    // usuario ainda nao esta logado nesse momento). So expoe email, nada
    // do resto do perfil. So o dono do uid pode criar/atualizar a propria
    // entrada, e o id do documento (nickname) impede duas contas com o
    // mesmo nickname (a segunda tentativa vira "update" de um dono diferente
    // e e barrada).
    match /nicknamesParaEmail/{nicknameChave} {
      // `get` aberto, `list` fechado — e a separacao e o ponto.
      //
      // `allow read` cobre os DOIS, e era isso que estava aqui. Na pratica
      // significava que qualquer pessoa, logada ou nao, conseguia baixar a
      // colecao inteira: todos os nicknames, e-mails e uids do app.
      //
      // A leitura aberta existe por um motivo real — o login por nickname
      // precisa resolver nick -> e-mail ANTES de haver sessao —, mas pra
      // isso basta ler UM documento pelo id. Listar nunca foi necessario.
      allow get: if true;

      // Duas listagens legitimas, e so elas:
      //
      // 1. a exclusao da PROPRIA conta, que precisa achar a reserva da
      //    pessoa (ela e indexada pelo nickname, nao pelo uid, entao so da
      //    pra achar por consulta);
      // 2. a remocao em cascata do Painel ADM, que faz a mesma consulta
      //    com o uid de outra pessoa.
      //
      // A condicao em `resource.data.uid` obriga a consulta do cliente a
      // filtrar por `uid == o meu`: sem o filtro, algum documento devolvido
      // reprova a regra e a consulta inteira e recusada. E o que impede a
      // colecao de ser baixada por completo.
      allow list: if ehAdmin() || (estaLogado() && resource.data.uid == request.auth.uid);
      allow create: if estaLogado() && request.auth.uid == request.resource.data.uid;
      allow update: if estaLogado()
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
      // Sem apagar, o nickname ficaria reservado pra sempre a uma conta que
      // nao existe mais, e ninguem poderia usa-lo de novo.
      //
      // O DONO entrou aqui em 14/set, junto com a exclusao da propria conta
      // (AuthRepository.excluirConta). Ate entao so o admin apagava, pela
      // remocao em cascata do Painel ADM — e o resultado era que quem
      // apagasse a propria conta deixava o nick travado.
      allow delete: if ehAdmin() || (estaLogado() && request.auth.uid == resource.data.uid);
    }

    // Feed (Home) e aba "Posts" do Painel ADM. Qualquer usuario logado
    // publica aviso de texto; enquete e midia (foto/video) sao privilegio
    // de admin. O que impede um inscrito de se passar por admin no feed sao
    // as tres checagens do create: autorUid tem que ser ele mesmo,
    // autorCargo tem que ser o cargo real gravado no perfil dele, e
    // prioridade tem que ser a do cargo — nao adianta o cliente mandar
    // 'admin'/100 na mao.
    //
    // Avisos de live (tipo 'aoVivo') sao escritos pelas Cloud Functions com
    // o Admin SDK, que ignora estas regras — por isso 'aoVivo' nao entra
    // nos tipos aceitos aqui.
    match /posts/{postId} {
      allow read: if estaLogado();

      allow create: if estaLogado()
        && !contaBloqueada()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorCargo == cargoDoUsuario()
        && request.resource.data.prioridade == prioridadeDoCargo(cargoDoUsuario())
        // Data vinda do servidor: o relogio do aparelho nao decide a
        // posicao do post no feed.
        && request.resource.data.criadoEm == request.time
        // Post nasce sem curtida nenhuma. A lista, e nao um contador: ver
        // podeCurtir() sobre por que nao ha um `curtidas` separado.
        && request.resource.data.curtidoPor == []
        && request.resource.data.comentariosCount == 0
        && (ehAdmin()
              ? request.resource.data.tipo in ['avisoTexto', 'avisoMidia', 'enquete']
              // Inscrito publica texto e so texto: nem o tipo com midia, nem
              // um avisoTexto com uma foto pendurada nele. Publicar imagem e
              // video sem ninguem revisar antes e o buraco mais facil de
              // furar as regras da comunidade (REGRAS_DA_COMUNIDADE.md).
              : (request.resource.data.tipo == 'avisoTexto'
                   && !request.resource.data.keys().hasAny(['fotoUrl', 'videoUrl'])));

      allow update: if ehAdmin() && tipoDePostagemValido(request.resource.data.tipo);
      allow update: if podeVotar();
      allow update: if podeTirarOProprioVoto();
      allow update: if podeCurtir();

      // Autor apaga o proprio post; admin apaga o de qualquer um.
      allow delete: if ehAdmin() || (estaLogado() && resource.data.autorUid == request.auth.uid);
    }

    // Caixa de entrada do WhatsApp (aba WhatsApp do Painel ADM).
    //
    // Escrita SO pelo webhook `whatsappWebhook`, que roda com o Admin SDK e
    // ignora estas regras — por isso `write: if false` aqui vale pra todo
    // mundo, admin incluido. Nenhum cliente inventa uma mensagem que a Meta
    // nunca entregou: o que esta nessa colecao ou veio do webhook, ou nao
    // existe.
    //
    // Leitura so pra admin: sao conversas de outras pessoas com o canal,
    // com telefone e nome de perfil.
    match /mensagensWhatsapp/{mensagemId} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
