rules_version = '2';

// Regras do Firebase Storage (separadas das do Firestore em firestore.rules).
// So guarda as fotos de perfil enviadas pelo usuario (ver
// AuthRepository.atualizarFotoPerfil / ModalCropFoto): cada usuario so pode
// escrever dentro da propria pasta "fotos_perfil/{uid}/", limitada a imagens
// de ate 5MB. Qualquer usuario logado pode ler (mesma logica de
// firestore.rules: perfis sao visiveis entre usuarios logados).
service firebase.storage {
  match /b/{bucket}/o {
    match /fotos_perfil/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
